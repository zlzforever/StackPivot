<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(StackPivot.Control.Components.Shared.MainLayout)">
            <NotAuthorized>
                <p>需要登录。</p>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <p>页面不存在。</p>
    </NotFound>
</Router>
