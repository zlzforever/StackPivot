@page "/"
@page "/workspaces"
@attribute [Authorize]
@rendermode InteractiveServer
@inject StackPivotDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserIdentityService UserIdentityService

<PageTitle>Workspaces</PageTitle>
<h1>Workspaces</h1>

@if (workspaces is null)
{
    <p>正在加载。</p>
}
else if (workspaces.Count == 0)
{
    <p>没有可访问的 Workspace。</p>
}
else
{
    <ul>
        @foreach (var workspace in workspaces)
        {
            <li>
                <strong>@workspace.DisplayName</strong>
                <span>@workspace.Name</span>
                <a href="/workspaces/@workspace.WorkspaceId/stacks">查看 Stack</a>
            </li>
        }
    </ul>
}

@code {
    private List<WorkspaceView>? workspaces;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        UserAccount user;
        try
        {
            user = await UserIdentityService.UpsertFromClaimsAsync(state.User, CancellationToken.None);
        }
        catch (UnauthorizedAccessException)
        {
            workspaces = new List<WorkspaceView>();
            return;
        }

        workspaces = await DbContext.Workspaces
            .AsNoTracking()
            .Where(value => user.IsPlatformAdmin || value.Members.Any(member => member.UserId == user.UserId))
            .OrderBy(value => value.Name)
            .Select(value => new WorkspaceView(value.WorkspaceId, value.Name, value.DisplayName))
            .ToListAsync();
    }
}
