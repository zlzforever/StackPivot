[Unit]
Description=StackPivot Agent
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=stackpivot-agent
Group=stackpivot-agent
# The docker group must already exist and be approved by the host operator.
SupplementaryGroups=docker
WorkingDirectory=/opt/agent-main
# EnvironmentFile values are not trusted for the credential selector. The
# fixed env assignment below is the only selector value visible to dotnet.
ExecStart=/usr/bin/env STACKPIVOT_AGENT_API_KEY_FILE=%d/agent-api-key /usr/bin/dotnet /opt/stackpivot-agent/StackPivot.Agent.dll
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group

Environment=DOTNET_ENVIRONMENT=Production
Environment=STACKPIVOT_AGENT_WORK_ROOT=/opt/agent-main
# This file is limited to non-sensitive identity, hub and Git host settings.
EnvironmentFile=/etc/stackpivot/agent.env
LoadCredential=agent-api-key:/etc/stackpivot/agent-api-key
# EnvironmentFile= has precedence over Environment=. Remove any attempt to
# inject this selector before ExecStart adds the fixed runtime credential path.
UnsetEnvironment=STACKPIVOT_AGENT_API_KEY_FILE

UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/agent-main
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=stackpivot-agent

[Install]
WantedBy=multi-user.target
